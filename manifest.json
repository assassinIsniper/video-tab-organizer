{
  "manifest_version": 3,
  "name": "视频标签页自动整理",
  "version": "1.0.0",
  "description": "自动把正在播放视频的标签页移到窗口右侧，并按打开时间排序。",
  "minimum_chrome_version": "102",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle",
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_title": "视频标签页整理",
    "default_popup": "popup.html"
  }
}